# Database
# PostgreSQL connection string
# For Neon: https://neon.tech
# For Supabase: https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=verify-full"

# NextAuth.js
# Generate secret: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
# Your production domain
AUTH_URL="https://itlsolutions.net"

# Site URL (public)
NEXT_PUBLIC_SITE_URL="https://itlsolutions.net"

# Admin credentials (for initial seed)
# Change these before running seed in production!
ADMIN_EMAIL="admin@itlsolutions.net"
ADMIN_PASSWORD="change-this-password"

# Email (Hostinger SMTP + IMAP)
# Mailbox: info@itlsolutions.net — hosted by Hostinger Business Email
# SMTP: smtp.hostinger.com:465 (SSL)
# IMAP: imap.hostinger.com:993 (SSL)
# Fill SMTP_PASS and IMAP_PASS with the mailbox password from Hostinger.
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@itlsolutions.net"
SMTP_PASS=""
SMTP_FROM="ITL Solutions <info@itlsolutions.net>"

IMAP_HOST="imap.hostinger.com"
IMAP_PORT="993"
IMAP_TLS="true"
IMAP_USER="info@itlsolutions.net"
IMAP_PASS=""

# Notification recipient for contact form + chat inquiries
EMAIL_TO="info@itlsolutions.net"

# Supabase Storage (for file uploads)
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Note: Create a bucket named "uploads" and make it public

# Analytics
# Google Analytics 4 - Get from https://analytics.google.com
NEXT_PUBLIC_GA4_ID="G-XXXXXXXXXX"
# Yandex Metrika - Get from https://metrika.yandex.ru
NEXT_PUBLIC_YANDEX_METRIKA_ID="123456789"

# Search Engine Verification (optional)
# GOOGLE_SITE_VERIFICATION="your-verification-code"
# YANDEX_VERIFICATION="your-verification-code"
